# Copy this to .env and adjust as needed. Every value here has a sensible
# default already baked into server.ts, so .env only needs to override what's
# actually different on your machine.

# Ollama's generate endpoint and the two models used for chat/code/vision.
# CODE_MODEL also handles Fusion 360 code generation and image verification
# for the multiview 3D-generation pipeline (see IMAGE_GEN_ROADMAP.md).
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_CODE_MODEL=qwen3.5:9b
# Only needed for document Q&A (attach a PDF/DOCX/text file in chat) — see
# GETTING_STARTED.md. Chat itself works fine without this model pulled.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Local SearXNG instance (web + image search) — see SEARXNG_SETUP.md.
SEARXNG_URL=http://localhost:8080

# Local speech service (Whisper STT + Kokoro TTS) — see SPEECH_SETUP.md.
SPEECH_SERVICE_URL=http://localhost:5001
SPEECH_SERVICE_PORT=5001
# Auto-launches the speech service on startup unless set to "false".
SPEECH_SERVICE_AUTOSTART=true
# Only needed if speech/ lives somewhere other than ./speech relative to
# where the server is run from.
SPEECH_SERVICE_DIR=

# Local vision service (camera + facial recognition) — see VISION_SETUP.md.
VISION_SERVICE_URL=http://localhost:5002
VISION_SERVICE_PORT=5002
# Off by default, unlike the speech service — this activates your webcam
# continuously in the background. See the Privacy section in
# VISION_SETUP.md before turning this on.
VISION_SERVICE_AUTOSTART=false
# Only needed if vision/ lives somewhere other than ./vision relative to
# where the server is run from.
VISION_SERVICE_DIR=

# Fusion 360 bridge add-in (NoahFusionBridge) — see FUSION_SETUP.md.
FUSION_BRIDGE_URL=http://localhost:9000

# Bambu Studio CLI, used to slice models before printing — see
# PRINTER_SETUP.md. The three profile paths must be set explicitly (no
# guessed default) once you've located them in your Bambu Studio install.
# Printer connectivity itself needs no config here — Bambu Connect (a
# separate app, see PRINTER_SETUP.md) handles its own account/printer
# binding outside of Noah.
BAMBU_STUDIO_EXE=C:\Program Files\Bambu Studio\bambu-studio.exe
BAMBU_MACHINE_PROFILE=
BAMBU_PROCESS_PROFILE=
BAMBU_FILAMENT_PROFILE=

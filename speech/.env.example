# Copy this to speech/.env and adjust as needed.

# Whisper (speech-to-text). Larger models are more accurate but slower —
# see the model size options at https://github.com/openai/whisper#available-models-and-languages
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# Defaults to int8 on cpu, float16 otherwise — only set this to override that.
WHISPER_COMPUTE_TYPE=

# Kokoro (text-to-speech). lang_code/voice pairs are documented at
# https://github.com/hexgrad/kokoro
KOKORO_LANG_CODE=a
KOKORO_VOICE=am_michael,am_adam
KOKORO_SPEED=1.0
KOKORO_USE_GPU=true
